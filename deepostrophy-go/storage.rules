rules_version = '2';

// DEEPostrophy — Firebase Storage Security Rules
// Firebase Console → Storage → Rules ট্যাবে এই পুরো ফাইলটি বসান, তারপর Publish করুন।
// (টেস্ট মোডের ডিফল্ট নিয়ম বাদ দিন — তা ৩০ দিন পর সব লক করে দেয়।)
//
// পাথের নকশা (index.html অনুযায়ী):
//   covers/<id>.jpg  → আইটেমের কভার ছবি (canvas-কম্প্রেস করা JPEG)
//   files/<id>/<নাম> → ZIP / ইনস্টলার ডাউনলোড ফাইল
//   items/..., stores/... → ভবিষ্যতে ব্যবহারের জন্যও খোলা রাখা হয়েছে
// প্রকাশ্য পড়া শুধু এই প্রিফিক্সগুলোতে; বাকি সব বন্ধ।

service firebase.storage {
  match /b/{bucket}/o {

    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'arafathhossainrifath230119@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // ছবি: সর্বোচ্চ ৫ MB এবং image/* ধরন
    function imageOk() {
      return request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // ফাইল (ZIP/ইনস্টলার): সর্বোচ্চ ১০০ MB এবং অনুমোদিত MIME
    function archiveOk() {
      return request.resource.size <= 100 * 1024 * 1024
        && request.resource.contentType.matches('application/zip|application/x-zip-compressed|application/x-msdownload|application/x-msi|application/vnd.microsoft.portable-executable|application/octet-stream');
    }

    // ---- কভার ছবি: যে কেউ পড়বে; মালিক ছবি আপলোড করবে ----
    match /covers/{coverPath=**} {
      allow read: if true;
      allow write: if isOwner() && imageOk();
      allow delete: if isOwner();
    }

    // ---- ডাউনলোড ফাইল: যে কেউ পড়বে; মালিক ZIP/ইনস্টলার আপলোড করবে ----
    match /files/{filePath=**} {
      allow read: if true;
      allow write: if isOwner() && archiveOk();
      allow delete: if isOwner();
    }

    // ---- items ও stores পাথ: পড়া সবার, লেখা মালিক (ছবি বা ফাইল) ----
    match /items/{itemPath=**} {
      allow read: if true;
      allow write: if isOwner() && (imageOk() || archiveOk());
      allow delete: if isOwner();
    }
    match /stores/{storePath=**} {
      allow read: if true;
      allow write: if isOwner() && (imageOk() || archiveOk());
      allow delete: if isOwner();
    }

    // ---- বাকি সব পাথ সম্পূর্ণ বন্ধ ----
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
